# run.bat creates .env from this template only when .env is missing.
# Local .env files are ignored by Git and excluded from Docker builds.

# Host port for the frontend; the container always listens on port 8000.
FRONTEND_PORT=8000

# Seconds between CSV checks when the optional analysis scanner is running.
# Must be greater than zero.
SCAN_INTERVAL=3

# run.bat reloads .env on each invocation; direct Python commands do not.
# Frontend API endpoints belong in app/frontend/assets/js/config.js.
# Never place AWS credentials, API keys, or passwords in frontend files.
# Add future backend-only private variables to your local .env, not this template.
# Single-quote private values containing dollar signs or comment characters.

# Future backend-only AWS integration (leave blank for local demo mode).
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
